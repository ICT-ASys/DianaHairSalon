    });

    function seleccionar(num, instant = false){
      const s = SERVICIOS.find(x => x.num === num);
      if (!s) return;
      activo = num;
      lista.querySelectorAll('.cat-item').forEach(it => {
        const on = it.dataset.num === num;
        it.classList.toggle('is-active', on);
        it.setAttribute('aria-selected', on);
      });
      const pintar = () => {
        stage.style.setProperty('--s1', s.c1);
        stage.style.setProperty('--s2', s.c2);
        stage.style.setProperty('--s3', s.c3);
        $('#stageNum').textContent = s.num;
        $('#stageCat').textContent = s.catLabel;
        $('#stageTitle').textContent = s.title;
        $('#stageDesc').textContent = s.desc;
        $('#stageTags').innerHTML = s.tags.map(t => `<li>${t}</li>`).join('');
        $('#stageCta').textContent = s.cta;
        $('#stageCta').href = WA + s.wa;
        contar($('#stagePrice'), s.price);
        stage.classList.remove('is-out');
        stage.classList.add('is-in');
      };
      if (instant || matchMedia('(prefers-reduced-motion:reduce)').matches) return pintar();
      stage.classList.remove('is-in'); stage.classList.add('is-out');
      clearTimeout(timer);
      timer = setTimeout(pintar, 250);
    }

    function contar(el, valor){
      const final = '$' + clp.format(valor);
      el.textContent = final;
      if (matchMedia('(prefers-reduced-motion:reduce)').matches) return;
      const t0 = performance.now(), dur = 650;
      const paso = t => {
        const p = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = p >= 1 ? final : '$' + clp.format(Math.round(valor * e));
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }

    stage.querySelectorAll('.magnet').forEach(el => {
      el.addEventListener('pointermove', e => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) / r.width;
        const y = (e.clientY - r.top - r.height / 2) / r.height;
        el.style.transform = `translate(${x * 7}px, ${y * 7 - 2}px)`;
      });
      el.addEventListener('pointerleave', () => { el.style.transform = ''; });
    });

    const art = $('#stageArt');
    art.addEventListener('pointermove', e => {
      const r = art.getBoundingClientRect();
      const dx = (e.clientX - r.left) / r.width - .5;
      const dy = (e.clientY - r.top) / r.height - .5;
      art.style.setProperty('--px', (dx * 16).toFixed(1) + 'px');
      art.style.setProperty('--py', (dy * 16).toFixed(1) + 'px');
      art.style.transform = `translate3d(${(dx * -8).toFixed(1)}px,${(dy * -8).toFixed(1)}px,0)`;
    });
    art.addEventListener('pointerleave', () => { art.style.transform = ''; });

    const io = new IntersectionObserver(es => es.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold:.15 });
    document.querySelectorAll('.rv').forEach(el => io.observe(el));

    const idleIO = new IntersectionObserver(es => es.forEach(e => {
      e.target.classList.toggle('is-idle', !e.isIntersecting);
    }), { threshold:0 });
    idleIO.observe(stage);

    document.querySelectorAll('.rv').forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < innerHeight * 0.92) el.classList.add('in');
    });

    seleccionar(SERVICIOS[0].num, true);
  </script>
</body>
</html>
