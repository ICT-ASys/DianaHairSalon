<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#7A1F45">
  <title>Diana Hair Salon | Belleza que se siente</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
  <style>
    :root { --wine:#C23B67; --wine-2:#D85C82; --ink:#3A2432; --paper:#fffaf6; --blush:#FDE7E4; --rose:#E58CA0; --gold:#D9A454; --line:rgba(194,59,103,.16); --shadow:0 22px 55px rgba(122,31,69,.18); --muted:#79525F; --ease:cubic-bezier(.2,.7,.2,1); }

    .catalog{padding:120px 0;position:relative;overflow:hidden}
    .catalog::before{content:"";position:absolute;width:640px;height:640px;border:1px solid rgba(122,31,69,.07);border-radius:50%;right:-260px;top:-180px;pointer-events:none}
    .catalog-head{max-width:720px}
    .catalog-head h2{margin-top:16px;font-size:clamp(2.2rem,4.2vw,3.4rem)}
    .catalog-head > p{margin-top:17px;color:var(--muted);font-size:1.02rem}

    .cat-filters{display:flex;flex-wrap:wrap;gap:9px;margin-top:30px}
    .chip{position:relative;padding:9px 17px;border:1px solid var(--line);border-radius:999px;font-size:.82rem;font-weight:700;color:#6d4a56;background:rgba(255,255,255,.7);transition:.28s var(--ease)}
    .chip::before{content:"";position:absolute;inset:0;border-radius:999px;background:var(--wine);transform:scale(.72);opacity:0;transition:.28s var(--ease)}
    .chip span{position:relative;z-index:1;transition:color .28s var(--ease)}
    .chip:hover{border-color:rgba(122,31,69,.28);color:var(--wine)}
    .chip.is-on{border-color:transparent;color:#fff}
    .chip.is-on::before{transform:scale(1);opacity:1}
    .chip b{font-weight:700;opacity:.55;margin-left:6px;font-size:.72rem}
    .chip.is-on b{opacity:.7}

    .cat-layout{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:56px;align-items:start;margin-top:56px}

    .cat-list{display:flex;flex-direction:column;gap:10px;border-top:1px solid var(--line);padding-top:6px}
    .cat-item{position:relative;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;width:100%;text-align:left;padding:19px 20px 19px 22px;border-radius:16px;transition:background .3s var(--ease),transform .3s var(--ease)}
    .cat-item::before{content:"";position:absolute;left:0;top:50%;width:3px;height:0;border-radius:3px;background:var(--gold);transform:translateY(-50%);transition:height .38s var(--ease)}
    .cat-item:hover{background:rgba(255,255,255,.85);transform:translateX(5px)}
    .cat-item.is-active{background:#fff;box-shadow:0 12px 30px rgba(74,15,37,.09)}
    .cat-item.is-active::before{height:58%}
    .cat-item-num{font-family:"Playfair Display",serif;font-size:.85rem;color:var(--gold);transition:color .3s var(--ease)}
    .cat-item.is-active .cat-item-num{color:var(--wine)}
    .cat-item-body{display:flex;flex-direction:column;gap:4px;min-width:0}
    .cat-item-title{font-family:"Playfair Display",serif;font-size:1.32rem;font-weight:600;letter-spacing:-.015em}
    .cat-item-meta{display:flex;align-items:center;gap:9px;font-size:.78rem;color:#8b6b77;font-weight:600}
    .cat-item-meta i{width:3px;height:3px;border-radius:50%;background:var(--gold);display:block;flex:none}
    .cat-item-arrow{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);color:var(--wine);font-size:.9rem;transition:.32s var(--ease)}
    .cat-item:hover .cat-item-arrow{border-color:var(--wine)}
    .cat-item.is-active .cat-item-arrow{background:var(--wine);color:#fff;border-color:var(--wine);transform:rotate(-45deg)}
    .cat-item.is-out{display:none}

    .cat-stage-wrap{position:sticky;top:26px}
    .cat-stage{position:relative;display:grid;grid-template-rows:clamp(150px,20vh,215px) 1fr;min-height:0;border-radius:28px;overflow:hidden;color:#fff;background:linear-gradient(140deg,#7A1F45,#A83763 55%,#A83763);box-shadow:0 30px 60px rgba(60,18,35,.24)}
    .stage-art{position:relative;overflow:hidden;isolation:isolate;contain:paint}
    .blob{position:absolute;display:block;border-radius:50%;will-change:transform;opacity:.9}
    .blob-1{width:400px;height:400px;left:-120px;top:-100px;background:radial-gradient(circle at 50% 50%,var(--s2,#E8799B) 0,transparent 62%);animation:blobA 17s ease-in-out infinite}
    .blob-2{width:340px;height:340px;right:-90px;top:20px;background:radial-gradient(circle at 50% 50%,var(--s3,#efd3c9) 0,transparent 60%);opacity:.62;animation:blobB 21s ease-in-out infinite}
    .blob-3{width:300px;height:300px;left:34%;bottom:-140px;background:radial-gradient(circle at 50% 50%,var(--s1,#A83763) 0,transparent 64%);opacity:.95;animation:blobC 25s ease-in-out infinite}
    .stage-ring{position:absolute;width:340px;height:340px;right:-120px;top:-130px;border:1px solid rgba(255,255,255,.22);border-radius:50%;box-shadow:0 0 0 46px rgba(255,255,255,.05),0 0 0 92px rgba(255,255,255,.028);animation:spin 40s linear infinite;will-change:transform}
    .stage-sheen{position:absolute;inset:0;background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,.14) 48%,transparent 58%);transform:translateX(-120%);animation:sheen 9s var(--ease) infinite;will-change:transform}
    .stage-grain{position:absolute;inset:0;opacity:.22;background-image:radial-gradient(rgba(255,255,255,.14) 1px,transparent 1px);background-size:4px 4px}
    .cat-stage.is-idle .blob,.cat-stage.is-idle .stage-ring,.cat-stage.is-idle .stage-sheen{animation-play-state:paused}
    .stage-num{position:absolute;left:30px;top:22px;font-family:"Playfair Display",serif;font-size:1.05rem;color:rgba(255,255,255,.8);letter-spacing:.06em}
    .stage-cat{position:absolute;right:30px;top:22px;font-size:.64rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.78);padding:7px 13px;border:1px solid rgba(255,255,255,.34);border-radius:999px;background:rgba(255,255,255,.08)}

    .stage-copy{padding:clamp(20px,2.4vw,28px) clamp(24px,3vw,34px) clamp(24px,2.6vw,30px);display:flex;flex-direction:column}
    .stage-title{font-size:clamp(1.85rem,3vw,2.75rem);letter-spacing:-.035em}
    .stage-desc{margin-top:10px;color:#f1dbdf;font-size:.95rem;line-height:1.6;max-width:44ch}
    .stage-tags{list-style:none;display:flex;flex-wrap:wrap;gap:7px;margin-top:16px;padding:0}
    .stage-tags li{font-size:.72rem;font-weight:600;color:#ffeef0;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);padding:5px 11px;border-radius:999px}
    .stage-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-top:auto;padding-top:22px;flex-wrap:wrap}
    .stage-price{display:flex;flex-direction:column;gap:3px}
    .stage-price small{font-size:.64rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#f0b9c2}
    .stage-price .amount{font-family:"Playfair Display",serif;font-size:clamp(1.5rem,2.2vw,1.8rem);line-height:1;background:linear-gradient(100deg,#fff,#ffd9c4 90%);-webkit-background-clip:text;background-clip:text;color:transparent}
    .stage-actions{display:flex;gap:10px;flex-wrap:wrap}
    .stage-actions .button.outline{color:#fff;border:1px solid rgba(255,255,255,.5)}
    .stage-actions .button.outline:hover{background:rgba(255,255,255,.14);transform:translateY(-2px)}
    .magnet{transition:transform .3s var(--ease)}

    .cat-stage.is-out .stage-art,.cat-stage.is-out .stage-copy{animation:swapOut .26s var(--ease) forwards}
    .cat-stage.is-in .stage-art,.cat-stage.is-in .stage-copy{animation:swapIn .5s var(--ease) both}
    .cat-stage.is-in .stage-copy{animation-delay:.05s}
    .stage-num,.stage-cat{animation:popIn .5s var(--ease) both}

    .rv{opacity:0;transform:translateY(24px);transition:opacity .7s var(--ease),transform .7s var(--ease);transition-delay:calc(var(--i,0)*80ms)}
    .rv.in{opacity:1;transform:none}

    .cat-note{margin-top:34px;font-size:.78rem;color:#96747f;display:flex;gap:9px;align-items:flex-start}
    .cat-note::before{content:"";width:16px;height:1px;background:currentColor;margin-top:.72em;flex:none}

    @keyframes blobA{0%,100%{transform:translate3d(0,0,0) scale(1)}33%{transform:translate3d(70px,52px,0) scale(1.14)}66%{transform:translate3d(-30px,80px,0) scale(.94)}}
    @keyframes blobB{0%,100%{transform:translate3d(0,0,0) scale(1)}40%{transform:translate3d(-80px,40px,0) scale(1.1)}70%{transform:translate3d(-20px,-46px,0) scale(.9)}}
    @keyframes blobC{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(60px,-58px,0) scale(1.16)}}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes sheen{0%,72%{transform:translateX(-120%)}88%,100%{transform:translateX(120%)}}
    @keyframes swapOut{to{opacity:0;transform:translateY(14px) scale(.985);filter:blur(6px)}}
    @keyframes swapIn{from{opacity:0;transform:translateY(20px) scale(.99);filter:blur(8px)}to{opacity:1;transform:none;filter:blur(0)}}
    @keyframes popIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:none}}

    @media (max-width:980px){
      .cat-layout{grid-template-columns:1fr;gap:34px}
      .cat-stage-wrap{position:static;z-index:5;order:-1}
      .cat-stage{scroll-margin-top:92px}
      .cat-stage{grid-template-rows:clamp(120px,15vh,160px) 1fr;min-height:0}
      .cat-item-title{font-size:1.15rem}
    }
    @media (max-width:560px){
      .catalog{padding:78px 0}
      .cat-stage{border-radius:22px}
      .stage-copy{padding:24px 22px 26px}
      .stage-foot{gap:16px}
      .stage-actions .button{padding:12px 18px;font-size:.82rem}
    }
    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{animation:none!important;transition:none!important}
      .rv{opacity:1;transform:none}
    }
    * { box-sizing:border-box; margin:0; }
    html { scroll-behavior:smooth; scroll-padding-top:90px; }
    body { background:var(--paper); color:var(--ink); font-family:"DM Sans",sans-serif; line-height:1.55; }
    a { color:inherit; text-decoration:none; }
    button,a { -webkit-tap-highlight-color:transparent; }
    .shell { width:min(1160px, calc(100% - 40px)); margin:auto; }
    .eyebrow { display:flex; align-items:center; gap:9px; color:var(--gold); font-size:.72rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }
    .eyebrow::before { content:""; width:28px; height:1px; background:currentColor; }
    h1,h2,h3 { font-family:"Playfair Display",serif; font-weight:600; line-height:1.08; }
    .button { display:inline-flex; justify-content:center; align-items:center; gap:10px; border-radius:999px; padding:13px 21px; font-size:.9rem; font-weight:700; transition:.25s ease; }
    .button svg { width:16px; height:16px; fill:currentColor; }
    .button.primary { color:white; background:var(--wine); box-shadow:0 10px 20px rgba(122,31,69,.2); }
    .button.primary:hover { background:#A83763; transform:translateY(-2px); box-shadow:0 14px 24px rgba(122,31,69,.28); }
    .button.light { color:var(--wine); background:white; }
    .button.light:hover { background:var(--blush); transform:translateY(-2px); }
    .button.outline { color:white; border:1px solid rgba(255,255,255,.55); }
    .button.outline:hover { background:rgba(255,255,255,.12); }

    /* navigation */
    nav { height:76px; display:flex; align-items:center; position:sticky; top:0; z-index:10; background:rgba(255,250,246,.9); backdrop-filter:blur(14px); border-bottom:1px solid transparent; }
    nav.scrolled { border-color:var(--line); }
    nav .shell { display:flex; align-items:center; justify-content:space-between; gap:20px; }
    .logo { color:var(--wine); font-family:"Playfair Display",serif; font-size:1.26rem; line-height:.9; }
    .logo small { display:block; margin-top:5px; font-family:"DM Sans",sans-serif; font-size:.52rem; letter-spacing:.23em; text-transform:uppercase; }
    .navlinks { display:flex; gap:27px; font-size:.83rem; font-weight:600; color:#6d4a56; }
    .nav-burger { display:none; flex-direction:column; justify-content:center; gap:5px; width:38px; height:38px; border-radius:10px; }
    .nav-burger span { width:20px; height:2px; background:var(--wine); margin:0 auto; border-radius:2px; transition:transform .28s var(--ease,ease),opacity .28s var(--ease,ease); }
    .nav-burger.is-open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .nav-burger.is-open span:nth-child(2) { opacity:0; }
    .nav-burger.is-open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
    .nav-drop { display:none; flex-direction:column; gap:2px; position:absolute; top:100%; left:0; right:0; width:min(1160px, calc(100% - 40px)); margin:0 auto; background:var(--paper); border-bottom:1px solid var(--line); box-shadow:0 18px 30px rgba(122,31,69,.1); padding:8px 4px 16px; }
    .nav-drop a:not(.button) { padding:13px 6px; font-size:.95rem; font-weight:600; color:#5c3a44; border-bottom:1px solid var(--line); }
    .nav-drop a.button { display:inline-flex; margin:12px 6px 2px; }
    .nav-drop.is-open { display:flex; }
    .navlinks a { position:relative; }
    .navlinks a::after { content:""; position:absolute; width:0; height:1px; left:0; bottom:-5px; background:var(--wine); transition:.2s; }
    .navlinks a:hover { color:var(--wine); }.navlinks a:hover::after { width:100%; }
    nav .button { padding:10px 16px; font-size:.78rem; }

    /* hero */
    .hero { position:relative; overflow:hidden; min-height:610px; color:white; background:var(--wine); isolation:isolate; display:flex; align-items:center; }
    .hero::before { content:""; position:absolute; inset:0; opacity:.54; background:radial-gradient(circle at 76% 24%,#E8799B 0,transparent 24%), radial-gradient(circle at 84% 78%,#A83763 0,transparent 27%), linear-gradient(116deg,#7A1F45 12%,#A83763 63%,#A83763 100%); z-index:-2; }
    .hero::after { content:""; position:absolute; width:680px; height:680px; border:1px solid rgba(255,255,255,.18); border-radius:50%; right:-180px; top:-290px; z-index:-1; box-shadow:0 0 0 70px rgba(255,255,255,.035),0 0 0 140px rgba(255,255,255,.025); }
    .hero-grid { display:grid; grid-template-columns:1.02fr .98fr; gap:50px; align-items:center; padding:74px 0; }
    .hero .eyebrow { color:#f2bec5; }.hero .eyebrow::before { background:#f2bec5; }
    h1 { max-width:690px; font-size:clamp(2.8rem,5.4vw,4.75rem); margin:17px 0 20px; letter-spacing:-.045em; }
    h1 em { color:#f4cbd0; font-weight:500; }
    .hero-copy > p { max-width:525px; color:#f6dfe2; font-size:1.04rem; }
    .hero-actions { display:flex; flex-wrap:wrap; gap:13px; margin-top:32px; }
    .hero-meta { display:flex; gap:24px; margin-top:47px; color:#f5d9de; font-size:.78rem; }
    .hero-copy .eyebrow, .hero-copy h1, .hero-copy > p, .hero-actions, .hero-meta, .hero-art {
      opacity:0; transform:translateY(42px);
      animation:heroRise .9s cubic-bezier(.16,.9,.28,1) forwards;
    }
    .hero-copy .eyebrow{animation-delay:.05s}
    .hero-copy h1{animation-delay:.16s}
    .hero-copy > p{animation-delay:.3s}
    .hero-actions{animation-delay:.42s}
    .hero-meta{animation-delay:.54s}
    .hero-art{animation-delay:.22s}
    @keyframes heroRise{to{opacity:1;transform:translateY(0)}}
    @media (prefers-reduced-motion:reduce){
      .hero-copy .eyebrow, .hero-copy h1, .hero-copy > p, .hero-actions, .hero-meta, .hero-art{
        animation:none; opacity:1; transform:none;
      }
    }
    .hero-meta strong { display:block; color:white; font-family:"Playfair Display",serif; font-size:1.12rem; font-weight:500; }
    .hero-art { min-height:405px; position:relative; }
    .portrait { position:absolute; width:min(100%,365px); aspect-ratio:4/5; right:25px; bottom:0; overflow:hidden; border-radius:180px 180px 16px 16px; background:linear-gradient(145deg,#e8b9ab,#9c4d63 45%,#7A1F45 46%,#7A1F45); box-shadow:24px 25px 0 rgba(245,222,218,.15); }
    .portrait img { width:100%; height:100%; object-fit:cover; display:block; }
    .art-stamp { position:absolute; z-index:2; left:0; bottom:45px; display:grid; place-items:center; width:104px; height:104px; border:1px solid rgba(255,255,255,.65); border-radius:50%; color:#fff; text-align:center; font-size:.62rem; line-height:1.25; transform:rotate(-14deg); }
    .art-stamp b { display:block; font-family:"Playfair Display",serif; font-size:1.2rem; }

    /* shared sections */
    section { padding:110px 0; }.section-head { max-width:640px; margin-bottom:47px; }.section-head h2 { margin-top:14px; font-size:clamp(2.2rem,4vw,3.35rem); letter-spacing:-.035em; }.section-head p { max-width:560px; color:#725662; margin-top:17px; }
    .service-grid { display:grid; grid-template-columns:1fr; gap:36px; }
    .service { min-height:500px; display:grid; grid-template-columns:55% 45%; position:relative; background:linear-gradient(112deg,#7A1F45,#A83763); color:#fff; border:1px solid rgba(255,255,255,.13); overflow:hidden; box-shadow:0 16px 32px rgba(74,15,37,.12); transition:box-shadow .35s ease,transform .35s ease; }
    .service:nth-child(even) { grid-template-columns:45% 55%; background:linear-gradient(112deg,#A83763,#A83763); }.service:nth-child(even) .service-visual { order:2; }.service:hover { transform:translateY(-9px); box-shadow:0 28px 48px rgba(74,15,37,.28); }.service-visual { position:relative; overflow:hidden; background:radial-gradient(circle at 74% 23%,#d9959d 0,transparent 22%),linear-gradient(135deg,#A83763,#A83763); }.service-visual::before { content:""; position:absolute; width:315px; height:400px; top:43px; left:50%; border-radius:52% 48% 44% 46%; transform:translateX(-48%) rotate(6deg); background:radial-gradient(ellipse at 50% 34%,#7A1F45 0 34%,transparent 34.5%),radial-gradient(ellipse at 50% 52%,#d99576 0 25%,transparent 25.5%),linear-gradient(160deg,transparent 0 68%,#7A1F45 68%); opacity:.93; filter:drop-shadow(0 23px 17px rgba(26,4,13,.28)); animation:figure-breathe 7s ease-in-out infinite; }.service-visual::after { content:""; position:absolute; width:380px; height:380px; border:1px solid rgba(255,255,255,.28); border-radius:50%; left:-150px; bottom:-195px; box-shadow:0 0 0 40px rgba(255,255,255,.055),0 0 0 80px rgba(255,255,255,.03); animation:orbital-drift 9s ease-in-out infinite; }
    .service:nth-child(2) .service-visual { background:radial-gradient(circle at 74% 23%,#f0c99a 0,transparent 22%),linear-gradient(135deg,#76502c,#D9A454); }.service:nth-child(2) .service-visual::before { background:radial-gradient(ellipse at 50% 34%,#4d2b19 0 34%,transparent 34.5%),radial-gradient(ellipse at 50% 52%,#d99576 0 25%,transparent 25.5%),linear-gradient(160deg,transparent 0 68%,#724928 68%); }
    .service:nth-child(3) .service-visual { background:radial-gradient(circle at 74% 23%,#cc7d94 0,transparent 22%),linear-gradient(135deg,#7A1F45,#A83763); }.service:nth-child(4) .service-visual { background:radial-gradient(circle at 74% 23%,#ddb6c0 0,transparent 22%),linear-gradient(135deg,#5d3443,#a55a73); }.service:nth-child(5) .service-visual { background:radial-gradient(circle at 74% 23%,#f1d3a5 0,transparent 22%),linear-gradient(135deg,#72512d,#E0B46E); }.service:nth-child(6) .service-visual { background:radial-gradient(circle at 74% 23%,#eeb5b8 0,transparent 22%),linear-gradient(135deg,#A83763,#b25d6b); }
    .service-number { position:absolute; left:27px; top:23px; z-index:2; color:rgba(255,255,255,.83); font-family:"Playfair Display",serif; font-size:.9rem; }.service-icon { position:absolute; left:28px; bottom:25px; z-index:2; display:grid; place-items:center; border-radius:50%; width:49px; height:49px; background:rgba(255,255,255,.92); color:var(--wine); }
    .service-icon svg { width:23px; fill:none; stroke:currentColor; stroke-width:1.5; }.service-copy { display:flex; min-width:0; flex-direction:column; justify-content:center; padding:62px; position:relative; }.service-copy::before { content:"SERVICIO · DIANA HAIR SALON"; color:#efb7c0; font-size:.67rem; letter-spacing:.18em; font-weight:700; margin-bottom:16px; }.service h3 { font-size:clamp(2.5rem,4.5vw,4.15rem); letter-spacing:-.05em; max-width:450px; }.service p { color:#f0d9dd; font-size:1rem; line-height:1.65; margin:18px 0 22px; max-width:385px; }.service-price { color:#fff; font-family:"Playfair Display",serif; font-size:1.2rem; margin-bottom:23px; }.service-price small { color:#ebb2bc; font-family:"DM Sans",sans-serif; font-size:.7rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; margin-right:8px; }.text-link { margin-top:0; align-self:flex-start; font-size:.82rem; font-weight:700; color:#fff; border-bottom:1px solid #efb7c0; padding-bottom:5px; }.text-link span { padding-left:5px; transition:.2s; }.text-link:hover span { padding-left:10px; }

    /* about owner */
    .about { background:#fff; }
    .about .shell { display:grid; grid-template-columns:.85fr 1.15fr; gap:64px; align-items:center; }
    .about-photo { position:relative; }
